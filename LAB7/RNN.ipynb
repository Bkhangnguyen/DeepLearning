    "# ==================== PHẦN 5: YÊU CẦU NÂNG CAO ====================\n",
    "# Thử nghiệm với các seq_length khác nhau\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(\"THỬ NGHIỆM VỚI CÁC SEQ_LENGTH KHÁC NHAU\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "def train_and_evaluate(seq_length, hidden_size=32, num_epochs=100):\n",
    "    print(f\"\\nĐang thử nghiệm với seq_length = {seq_length}...\")\n",
    "    \n",
    "    # Tạo chuỗi con với seq_length mới\n",
    "    X_seq_temp, y_seq_temp = create_sequences(data_scaled, target_scaled, seq_length)\n",
    "    X_seq_temp = torch.FloatTensor(X_seq_temp)\n",
    "    y_seq_temp = torch.FloatTensor(y_seq_temp)\n",
    "    \n",
    "    # Chia dữ liệu\n",
    "    total = len(X_seq_temp)\n",
    "    train_sz = int(0.7 * total)\n",
    "    val_sz = int(0.15 * total)\n",
    "    \n",
    "    X_train_temp = X_seq_temp[:train_sz]\n",
    "    y_train_temp = y_seq_temp[:train_sz]\n",
    "    X_val_temp = X_seq_temp[train_sz:train_sz + val_sz]\n",
    "    y_val_temp = y_seq_temp[train_sz:train_sz + val_sz]\n",
    "    X_test_temp = X_seq_temp[train_sz + val_sz:]\n",
    "    y_test_temp = y_seq_temp[train_sz + val_sz:]\n",
    "    \n",
    "    # Khởi tạo mô hình\n",
    "    model_temp = RNN(input_size=3, hidden_size=hidden_size, output_size=1)\n",
    "    optimizer_temp = torch.optim.Adam(model_temp.parameters(), lr=0.01)\n",
    "    \n",
    "    # Huấn luyện\n",
    "    train_losses = []\n",
    "    val_losses = []\n",
    "    \n",
    "    for epoch in range(num_epochs):\n",
    "        # Train\n",
    "        model_temp.train()\n",
    "        total_train = 0\n",
    "        indices = torch.randperm(len(X_train_temp))[:batch_size]\n",
    "        X_batch = X_train_temp[indices]\n",
    "        y_batch = y_train_temp[indices]\n",
    "        hidden = model_temp.init_hidden(batch_size)\n",
    "        output, _ = model_temp(X_batch, hidden)\n",
    "        loss = criterion(output, y_batch)\n",
    "        optimizer_temp.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer_temp.step()\n",
    "        total_train = loss.item()\n",
    "        \n",
    "        # Validation\n",
    "        model_temp.eval()\n",
    "        total_val = 0\n",
    "        with torch.no_grad():\n",
    "            val_indices = torch.randperm(len(X_val_temp))[:batch_size]\n",
    "            X_val_batch = X_val_temp[val_indices]\n",
    "            y_val_batch = y_val_temp[val_indices]\n",
    "            hidden_val = model_temp.init_hidden(batch_size)\n",
    "            output_val, _ = model_temp(X_val_batch, hidden_val)\n",
    "            val_loss = criterion(output_val, y_val_batch)\n",
    "            total_val = val_loss.item()\n",
    "        \n",
    "        train_losses.append(total_train)\n",
    "        val_losses.append(total_val)\n",
    "    \n",
    "    return train_losses, val_losses\n",
    "\n",
    "# Thử nghiệm với các seq_length khác nhau\n",
    "seq_lengths = [10, 20, 30]\n",
    "results = {}\n",
    "\n",
    "for sl in seq_lengths:\n",
    "    train_loss, val_loss = train_and_evaluate(sl, num_epochs=100)\n",
    "    results[sl] = {'train': train_loss, 'val': val_loss}\n",
    "    \n",
    "    plt.figure(figsize=(10, 5))\n",
    "    plt.plot(train_loss, label=f'Train Loss (seq={sl})')\n",
    "    plt.plot(val_loss, label=f'Val Loss (seq={sl})')\n",
    "    plt.xlabel('Epoch')\n",
    "    plt.ylabel('Loss')\n",
    "    plt.title(f'Kết quả huấn luyện với seq_length = {sl}')\n",
    "    plt.legend()\n",
    "    plt.grid(True, linestyle='--', alpha=0.7)\n",
    "    plt.show()\n",
    "\n",
    "# Nhận xét\n",
